    "Score = np.zeros(95)\n",
    "Posicion = np.zeros(95)\n",
    "Time = np.zeros(95)\n",
    "for i in range(5,100):\n",
    "    k = i   # Número de vecinos\n",
    "    Score_ind=np.zeros(5)\n",
    "    Posicion_ind=np.zeros(5)\n",
    "    Time_ind=np.zeros(5)\n",
    "    for u in range (1,6):\n",
